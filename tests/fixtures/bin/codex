#!/usr/bin/env bash
# Fake Codex CLI for CI / offline tests. Supports the minimum surface the
# wrapper and installer depend on: --version, exec --help, and exec with
# --output-last-message.
#
# Not a real Codex. Produces a deterministic mock response. Do not install
# this on PATH outside of test environments.

set -eu

case "${1:-}" in
  --version)
    echo "codex-cli 0.121.0-fake"
    exit 0
    ;;
  exec)
    shift
    if [[ "${1:-}" == "--help" ]]; then
      cat <<'EOF'
Run Codex non-interactively (FAKE for tests)

Usage: codex exec [OPTIONS] [PROMPT]

Options:
  -s, --sandbox <MODE>                 (possible values: read-only, workspace-write, danger-full-access)
  -c, --config <key=value>             Override a configuration value
  -m, --model <MODEL>                  Model to use
  -C, --cd <DIR>                       Working root
      --skip-git-repo-check
      --color <COLOR>
  -o, --output-last-message <FILE>
      --help
EOF
      exit 0
    fi
    OUT=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -o|--output-last-message)   OUT="$2"; shift 2 ;;
        --output-last-message=*)    OUT="${1#*=}"; shift ;;
        *)                          shift ;;
      esac
    done
    if [[ -n "$OUT" ]]; then
      cat <<'EOF' > "$OUT"
# Mock Codex response (from tests/fixtures/bin/codex)

This response was generated by the fake Codex binary used in CI and unit tests.
It is not a real Codex call; no model was invoked.

## Findings

- Fake finding 1 at `tests/fixtures/bin/codex:1`
- Fake finding 2 at `tests/fixtures/bin/codex:2`

## Summary

Wrapper invocation plumbing works end-to-end.
EOF
    fi
    exit 0
    ;;
esac

echo "fake codex: unsupported command: ${1:-<none>}" >&2
exit 2
